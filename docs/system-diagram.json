  "cards": [
    { "dot": "cyan", "title": "How the two apps connect", "items": [
      "Explorer opens Analytics with window.open(?rrcHandoff=<id>) and posts the dataset package by postMessage",
      "Both sides check the exact origin (:4391 ↔ :4290) and the opener window",
      "Analytics re-hashes every file against the manifest; nothing is used until the engineer confirms"
    ] },
    { "dot": "emerald", "title": "Run and deploy", "items": [
      "docker compose up --build: Postgres, Explorer and Analytics (built from its repo at 444382e)",
      "Live: both apps on Lovable; Explorer's public reads via the trrc-explorer Supabase Edge Function, collection switched off",
      "CI on every PR (tests, Compose, observability); deploy-dev after CI on main; deploy-prod is manual, rollback = earlier commit",
      "Analytics CI runs test and docker on every PR and push to main"
    ] },
    { "dot": "rose", "title": "Watching the key journey", "items": [
      "Each collect is one trace (load, normalize-qc, export) with metrics and logs sharing its trace ID",
      "Rule 'Explorer collection failed' fires on a failed collect and calls the receiver",
      "With --respond, the receiver starts the on-call agent, which diagnoses, fixes and opens a PR for review"
    ] },
    { "dot": "slate", "title": "Evidence", "items": [
      "Sources cite a local snapshot of both repositories: texas-rail-sync af43517 and well-injection-insights 436c950"
    ] }
